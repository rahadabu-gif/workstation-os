<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORKSTATION OS"
            android:textColor="@color/accent_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMotivationBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/dark_card"
            android:padding="16dp"
            android:text="“Discipline is choosing between what you want now and what you want most.”"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DAILY ANALYSIS"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/dark_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCompletionRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activities Completed: 0 / 4 (0%)"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/pbCompletion"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:progress="0"
                android:progressTint="@color/accent_green" />

            <TextView
                android:id="@+id/tvDistractions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Distractions Blocked Today: 0"
                android:textColor="@color/accent_red"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TODAY'S TARGET PLAN"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTargetPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/dark_card"
            android:hint="Enter core objective"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DAILY ACTIVITIES CHECKLIST"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/dark_card"
            android:orientation="vertical"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/cbTask1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Study Block 1 (90 Mins)"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbTask2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep Study Block 2 (90 Mins)"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbTask3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Revision &amp; Question Practice"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbTask4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Physical Workout / Health Routine"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ENFORCEMENT &amp; VOICE ALERTS"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/dark_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnforce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Block Facebook &amp; Apps (Force Mode)"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Enable Custom Voice Alerts"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Custom Voice Text Warning:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCustomVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#273549"
                android:padding="10dp"
                android:text="Stop scrolling! Put the phone down and work."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_blue"
                android:text="Save All Configuration"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/dark_card"
                android:text="Enable App Blocker Permission"
                android:textColor="@color/accent_blue" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
